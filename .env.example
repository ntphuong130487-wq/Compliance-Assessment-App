# Compliance Assessment App – production environment
# Do not commit real secrets.

AUTH_MODE=clerk
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
APP_URL=

# Optional but recommended for first administrator bootstrap.
# Use comma-separated email(s); remove after permanent admin metadata is established if desired.
AUTH_BOOTSTRAP_ADMIN_EMAILS=

# Restrict invitations to approved email domains, comma-separated.
# Empty = no domain restriction.
AUTH_ALLOWED_EMAIL_DOMAINS=

DATABASE_URL=
BLOB_READ_WRITE_TOKEN=

# Optional integration capabilities
REGULATION_SEARCH_PROVIDER=
AI_GATEWAY_API_KEY=
AI_EXTRACTION_MODEL=
NOTIFICATION_WEBHOOK_URL=
CRON_SECRET=

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agris.local/schemas/ai-obligation-extraction-v2.schema.json",
  "title": "AgriS Compliance Obligation Extraction v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion","sourceId","assessmentId","humanReviewRequired","obligations"],
  "properties": {
    "schemaVersion": {"const":"v2"},
    "sourceId": {"type":["string","null"]},
    "assessmentId": {"type":["string","null"]},
    "humanReviewRequired": {"const":true},
    "obligations": {
      "type":"array","maxItems":150,
      "items":{
        "type":"object","additionalProperties":false,
        "required":["sourceClause","originalText","obligation","actorText","actionText","objectText","applicability","obligationType","mandatoryLevel","expectedEvidence","testProcedure","confidence","reviewReasons","uncertainties"],
        "properties":{
          "sourceClause":{"type":"string","maxLength":500},
          "originalText":{"type":"string","maxLength":8000},
          "obligation":{"type":"string","minLength":12,"maxLength":6000},
          "actorText":{"type":"string","maxLength":1000},
          "actionText":{"type":"string","maxLength":2000},
          "objectText":{"type":"string","maxLength":2000},
          "conditionText":{"type":"string","maxLength":2000},
          "exceptionText":{"type":"string","maxLength":2000},
          "timingText":{"type":"string","maxLength":1000},
          "frequencyText":{"type":"string","maxLength":1000},
          "applicability":{"type":"string","maxLength":3000},
          "applicableOrgRefs":{"type":"array","maxItems":30,"items":{"type":"string","maxLength":300}},
          "applicableProcessRefs":{"type":"array","maxItems":30,"items":{"type":"string","maxLength":300}},
          "applicableActivityRefs":{"type":"array","maxItems":30,"items":{"type":"string","maxLength":300}},
          "applicableRoleRefs":{"type":"array","maxItems":30,"items":{"type":"string","maxLength":300}},
          "controlPoint":{"type":"string","maxLength":2000},
          "controlObjective":{"type":"string","maxLength":2000},
          "obligationType":{"enum":["general","prohibition","approval","record","reporting","condition","responsibility"]},
          "mandatoryLevel":{"enum":["mandatory","conditional","review"]},
          "expectedEvidence":{"type":"string","maxLength":3000},
          "testProcedure":{"type":"string","maxLength":3000},
          "verificationMethod":{"type":"string","maxLength":3000},
          "confidence":{"type":"number","minimum":0,"maximum":1},
          "fieldConfidence":{"type":"object","additionalProperties":true},
          "reviewReasons":{"type":"array","maxItems":15,"items":{"type":"string","maxLength":300}},
          "uncertainties":{"type":"array","maxItems":15,"items":{"type":"string","maxLength":500}}
        }
      }
    }
  }
}
